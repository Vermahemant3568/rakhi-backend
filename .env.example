APP_NAME=rakhi
APP_ENV=production
APP_KEY=base64:your_app_key_here
APP_DEBUG=false
APP_URL=https://api.rakhihealth.in
FRONTEND_URL=https://rakhiadmin.netlify.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database ───────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=rakhi-db.cdgo4uo6a0ln.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=rakhi_ai
DB_USERNAME=rakhi
DB_PASSWORD=rakhehealth123

# ─── Session & Cache ────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

# ─── Queue ──────────────────────────────────────────
QUEUE_CONNECTION=database

# ─── Broadcasting ───────────────────────────────────
BROADCAST_CONNECTION=pusher
BROADCAST_DRIVER=pusher

# ─── Filesystem ─────────────────────────────────────
FILESYSTEM_DISK=local

# ─── Mail ───────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@rakhi.ai"
MAIL_FROM_NAME="Rakhi"

# ─── JWT ────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ─── Pusher ─────────────────────────────────────────
PUSHER_APP_ID=your_pusher_app_id
PUSHER_APP_KEY=your_pusher_app_key
PUSHER_APP_SECRET=your_pusher_app_secret
PUSHER_APP_CLUSTER=ap2

# ─── Pinecone — ENV fallback (can also be set from Admin Panel → API Manager) ──
# If set here, used as fallback when DB value is empty.
# Recommended: set in Admin Panel so no server restart needed.
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_HOST=https://your-index-host.svc.pinecone.io
PINECONE_INDEX=rakhi-ai

# ─── All other API keys ─────────────────────────────
# MSG91, Fast2SMS, Razorpay, Firebase, Google STT/TTS, Gemini, ChatGPT
# are managed ONLY from Admin Panel → API Manager & LLM Config
# Do NOT set them here — they are stored in the database
