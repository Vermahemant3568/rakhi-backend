APP_NAME=Rakhi
APP_ENV=production
APP_KEY=base64:your_app_key_here
APP_DEBUG=false
APP_URL=https://api.rakhihealth.in
FRONTEND_URL=https://rakhiadmin.netlify.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database ───────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rakhi_ai
DB_USERNAME=root
DB_PASSWORD=

# ─── Session & Cache ────────────────────────────────
# Use file driver — avoids needing a cache DB table
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

# ─── Queue ──────────────────────────────────────────
QUEUE_CONNECTION=database

# ─── Broadcasting (Pusher) ──────────────────────────
BROADCAST_CONNECTION=pusher
BROADCAST_DRIVER=pusher

PUSHER_APP_ID=your_pusher_app_id
PUSHER_APP_KEY=your_pusher_app_key
PUSHER_APP_SECRET=your_pusher_app_secret
PUSHER_APP_CLUSTER=ap2

# ─── Filesystem ─────────────────────────────────────
FILESYSTEM_DISK=local

# ─── Mail (log only — not used) ─────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@rakhi.ai"
MAIL_FROM_NAME="Rakhi"

# ─── JWT ────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ─── Pinecone (fallback if not set in admin panel) ──
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_HOST=https://your-pinecone-host.svc.pinecone.io

# ─── All other API keys ─────────────────────────────
# MSG91, Razorpay, Firebase, Google, Gemini, ChatGPT
# are managed from the Admin Panel → API Manager
# Do NOT set them here — they are read from the database
